# Moltbook
MOLTBOOK_API_KEY=
MOLTBOOK_API_BASE=https://www.moltbook.com/api/v1
MOLTBOOK_DRY_RUN=false

# Bot
BOT_NAME=gingeredspi4395
BOT_SUBMOLT=general
BOT_STATE_PATH=.gingeredspi4395_moltbook_state.json

# Autonomia
# 14400 = 4 horas. Para testes manuais, use heartbeat --max-autonomy.
GINGER_AUTONOMY_INTERVAL_SECONDS=14400
GINGER_MAX_ACTIONS_PER_HEARTBEAT=3
GINGER_AUTO_REPLY_DMS=true
# Deixe false: pedido novo de DM deve ser aprovado por você.
# Troque para true só se quiser autonomia máxima mesmo para abrir conversas.
GINGER_AUTO_APPROVE_DM_REQUESTS=false
